rules_version = '2';

// ===============================================================
// Sistema PT — reglas de seguridad de Firestore
// ===============================================================
//
// Modelo de acceso: entra cualquier cuenta de Google con el correo verificado, y cada
// persona trabaja con sus propios datos. Nadie ve ni escribe lo de otro.
//
// El aislamiento es estructural, no solo por campo: todo vive bajo
// `usuarios/{uid}/…` y las reglas comparan ese `uid` con el de quien pide. Dos
// razones para hacerlo con la ruta y no con un campo `creadoPor`:
//
//   1. Los identificadores de documento se derivan del dato —el NIT en `clientes`,
//      la razón social normalizada en `comparablesHistoricas`—, así que dos personas
//      que trabajen el mismo cliente pedirían el mismo documento. Con una colección
//      común, el segundo choca con el documento del primero y no puede escribir.
//   2. Una consulta sobre una colección común tiene que filtrar por el dueño o
//      Firestore la rechaza entera. Bajo la ruta del usuario eso ya no hace falta.
//
// El acceso abierto es una decisión explícita del usuario. Consecuencia a tener presente:
// quien encuentre la URL puede crear su espacio y consumir cuota de Firestore y de las
// API de IA, que no piden autenticación. Los datos existentes siguen inaccesibles.
//
// ===============================================================
// Modelo de datos asumido
// ===============================================================
//
// usuarios/{uid}/estudios/{estudioId}          — el estudio completo del gestor
// usuarios/{uid}/clientes/{nit}                — contribuyentes del consultor
// usuarios/{uid}/comparablesHistoricas/{clave} — su catálogo de comparables
// usuarios/{uid}/eeffComparables/{registroId}  — cifras ya leídas de un EEFF
//
// Los campos de cada documento son los mismos que antes; se detallan en los
// validadores de más abajo. `creadoPor` se conserva —redundante con la ruta— porque
// es el rastro de autoría que muestra la aplicación y porque la migración se apoya
// en él para saber qué mover.
//
// ===============================================================
// Limitaciones conocidas
// ===============================================================
//
// 1. `estudios.datos` es un map libre: es el estudio completo del gestor y su forma
//    cambia con la aplicación. Se valida que sea un map; su contenido no.
// 2. Las reglas no pueden iterar listas: de `apariciones`, `anios` y `hallazgos` se
//    valida el tipo y el tamaño máximo, no cada elemento.
// 3. Las colecciones de primer nivel quedan como zona de solo lectura y borrado del
//    propio dueño, para que cada uno pueda migrar lo que dejó ahí el modelo
//    compartido anterior. No se puede crear nada nuevo en ellas.

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================
    // Funciones de apoyo
    // =============================================================

    /* Cualquier cuenta de Google puede entrar, por decisión del usuario: ya no se exige
       el dominio corporativo. Lo que protege los datos es el aislamiento por usuario
       —todo vive bajo `usuarios/{uid}/…` y estas reglas comparan ese uid con el de quien
       pide—, así que alguien de fuera solo alcanza su propio espacio vacío.

       El correo verificado sí se sigue exigiendo: es lo que impide reclamar una dirección
       ajena, y de ello depende la compartición, que se concede por correo. */
    function esMiembro() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    // Sesión válida y dueño del espacio al que se está entrando.
    function esDueno(uid) {
      return esMiembro() && request.auth.uid == uid;
    }

    function tieneTodos(campos) {
      return request.resource.data.keys().hasAll(campos);
    }

    function soloEstosCampos(campos) {
      return request.resource.data.keys().hasOnly(campos);
    }

    function texto(valor, minimo, maximo) {
      return valor is string && valor.size() >= minimo && valor.size() <= maximo;
    }

    function textoOpcional(datos, campo, maximo) {
      return !(campo in datos) || datos[campo] == null
        || (datos[campo] is string && datos[campo].size() <= maximo);
    }

    function numeroOpcional(datos, campo, minimo, maximo) {
      return !(campo in datos) || datos[campo] == null
        || (datos[campo] is number && datos[campo] >= minimo && datos[campo] <= maximo);
    }

    function listaOpcional(datos, campo, maximo) {
      return !(campo in datos) || (datos[campo] is list && datos[campo].size() <= maximo);
    }

    // Nombre propio denormalizado: no puede ser el de otra persona. Si el proveedor
    // trae `name` en el token —Google sí lo trae—, el valor guardado debe coincidir.
    function nombrePropio(datos, campo) {
      return !(campo in datos) || datos[campo] == null
        || (datos[campo] is string && datos[campo].size() <= 120
            && (!('name' in request.auth.token) || datos[campo] == request.auth.token.name));
    }

    // `creadoEn` solo se acota por arriba, no por abajo: la migración al espacio
    // privado reescribe cada documento conservando su fecha de creación original, que
    // es lo correcto —falsearla perdería el rastro de cuándo se hizo el estudio— y con
    // una ventana de minutos toda esa migración sería rechazada. Sigue siendo imposible
    // fechar en el futuro, que es lo que permitiría colarse al principio de un orden.
    function creacionCoherente(datos) {
      return datos.creadoPor == request.auth.uid
        && datos.creadoEn is timestamp
        && datos.creadoEn <= request.time
        && datos.actualizadoEn is timestamp
        && datos.actualizadoEn <= request.time
        && nombrePropio(datos, 'creadoPorNombre')
        && nombrePropio(datos, 'actualizadoPorNombre');
    }

    function modificacionCoherente(datos) {
      return datos.creadoPor == resource.data.creadoPor
        && datos.creadoEn == resource.data.creadoEn
        && (('creadoPorNombre' in datos) == ('creadoPorNombre' in resource.data))
        && (!('creadoPorNombre' in datos) || datos.creadoPorNombre == resource.data.creadoPorNombre)
        && datos.actualizadoEn is timestamp
        && datos.actualizadoEn <= request.time
        && datos.actualizadoEn > request.time - duration.value(5, 'm')
        && (!('actualizadoPor' in datos) || datos.actualizadoPor == request.auth.uid)
        && nombrePropio(datos, 'actualizadoPorNombre');
    }

    function nombreCoherente(datos, campo) {
      return !(campo in datos) || datos[campo] == null
        || (datos[campo] is string && datos[campo].size() <= 120);
    }

    // =============================================================
    // Validadores de dominio
    // =============================================================

    function clienteValido(d) {
      return soloEstosCampos(['nit', 'razonSocial', 'ciiu', 'objeto', 'representante',
                              'actividadEspecifica', 'creadoPor', 'creadoPorNombre',
                              'creadoEn', 'actualizadoPor', 'actualizadoPorNombre',
                              'actualizadoEn'])
        && tieneTodos(['nit', 'razonSocial', 'creadoPor', 'creadoEn', 'actualizadoEn'])
        && texto(d.nit, 5, 30)
        && d.nit.matches('^[0-9]+$')
        && texto(d.razonSocial, 1, 200)
        && textoOpcional(d, 'ciiu', 20)
        && textoOpcional(d, 'objeto', 4000)
        && textoOpcional(d, 'representante', 200)
        && textoOpcional(d, 'actividadEspecifica', 4000)
        && texto(d.creadoPor, 1, 128)
        && nombreCoherente(d, 'creadoPorNombre')
        && nombreCoherente(d, 'actualizadoPorNombre');
    }

    function estudioValido(d) {
      return soloEstosCampos(['ent', 'nit', 'anio', 'clienteNit', 'datos', 'compartidoCon',
                              'creadoPor', 'creadoPorNombre', 'creadoEn',
                              'actualizadoPor', 'actualizadoPorNombre', 'actualizadoEn'])
        && tieneTodos(['ent', 'anio', 'datos', 'creadoPor', 'creadoEn', 'actualizadoEn'])
        && texto(d.ent, 1, 200)
        && textoOpcional(d, 'nit', 30)
        && textoOpcional(d, 'clienteNit', 30)
        && d.anio is number && d.anio >= 2000 && d.anio <= 2100
        && d.datos is map
        && listaOpcional(d, 'compartidoCon', 25)
        && texto(d.creadoPor, 1, 128)
        && nombreCoherente(d, 'creadoPorNombre')
        && nombreCoherente(d, 'actualizadoPorNombre');
    }

    /* ── compartición de un estudio ──
       Privado por defecto. El dueño puede habilitar a compañeros del dominio uno a uno,
       y lo que concede es LECTURA: si dos personas pudieran guardar el mismo estudio
       volvería el problema que este modelo viene a cerrar —un estudio creado por alguien
       y modificado por otro sin que ninguno lo supiera.

       Se comparte por correo y no por identificador de usuario porque no existe un
       directorio del equipo: nadie puede averiguar el uid de un compañero, mientras que
       su correo sí lo conoce. `token.email` viene de Google, en minúsculas y verificado,
       así que la lista se guarda igualmente normalizada. */
    function estudioCompartidoConmigo() {
      return esMiembro()
        && 'compartidoCon' in resource.data
        && resource.data.compartidoCon is list
        && request.auth.token.email.lower() in resource.data.compartidoCon;
    }

    function comparableValida(d) {
      return soloEstosCampos(['nombre', 'nameKey', 'pais', 'actividad', 'pli', 'margen',
                              'anios', 'apariciones', 'creadoPor', 'creadoPorNombre',
                              'creadoEn', 'actualizadoPor', 'actualizadoPorNombre',
                              'actualizadoEn'])
        && tieneTodos(['nombre', 'nameKey', 'apariciones', 'creadoPor', 'creadoEn', 'actualizadoEn'])
        && texto(d.nombre, 1, 200)
        && texto(d.nameKey, 1, 200)
        && textoOpcional(d, 'pais', 80)
        && textoOpcional(d, 'actividad', 4000)
        && textoOpcional(d, 'pli', 40)
        && numeroOpcional(d, 'margen', -100, 100)
        && listaOpcional(d, 'anios', 40)
        && d.apariciones is list && d.apariciones.size() <= 200
        && texto(d.creadoPor, 1, 128)
        && nombreCoherente(d, 'creadoPorNombre')
        && nombreCoherente(d, 'actualizadoPorNombre');
    }

    function eeffValido(d) {
      return soloEstosCampos(['nameKey', 'nombre', 'anio', 'ingresos', 'costos',
                              'utilidadOperacional', 'cartera', 'inventarios',
                              'proveedores', 'fuente', 'hallazgos', 'creadoPor',
                              'creadoPorNombre', 'creadoEn', 'actualizadoPor',
                              'actualizadoPorNombre', 'actualizadoEn'])
        && tieneTodos(['nameKey', 'nombre', 'anio', 'creadoPor', 'creadoEn', 'actualizadoEn'])
        && texto(d.nameKey, 1, 200)
        && texto(d.nombre, 1, 200)
        && d.anio is number && d.anio >= 1990 && d.anio <= 2100
        && numeroOpcional(d, 'ingresos', -1000000000000, 1000000000000)
        && numeroOpcional(d, 'costos', -1000000000000, 1000000000000)
        && numeroOpcional(d, 'utilidadOperacional', -1000000000000, 1000000000000)
        && numeroOpcional(d, 'cartera', -1000000000000, 1000000000000)
        && numeroOpcional(d, 'inventarios', -1000000000000, 1000000000000)
        && numeroOpcional(d, 'proveedores', -1000000000000, 1000000000000)
        && textoOpcional(d, 'fuente', 300)
        && listaOpcional(d, 'hallazgos', 50)
        && texto(d.creadoPor, 1, 128)
        && nombreCoherente(d, 'creadoPorNombre')
        && nombreCoherente(d, 'actualizadoPorNombre');
    }

    // =============================================================
    // Espacio privado de cada consultor
    // =============================================================

    match /usuarios/{uid} {

      // El documento `usuarios/{uid}` en sí no se usa: las subcolecciones existen sin
      // él. Se niega explícitamente para que nadie lo use como almacén sin validar.
      allow read, write: if false;

      /* Lo lee su dueño, y además quien él haya habilitado expresamente. Escribir y
         borrar siguen siendo solo del dueño: compartir concede lectura, no edición. */
      match /estudios/{estudioId} {
        allow read: if esDueno(uid) || estudioCompartidoConmigo();
        allow create: if esDueno(uid)
          && estudioValido(request.resource.data)
          && creacionCoherente(request.resource.data);
        allow update: if esDueno(uid)
          && estudioValido(request.resource.data)
          && modificacionCoherente(request.resource.data);
        allow delete: if esDueno(uid);
      }

      match /clientes/{nit} {
        allow read: if esDueno(uid);
        allow create: if esDueno(uid)
          && clienteValido(request.resource.data)
          && request.resource.data.nit == nit
          && creacionCoherente(request.resource.data);
        allow update: if esDueno(uid)
          && clienteValido(request.resource.data)
          && request.resource.data.nit == nit
          && modificacionCoherente(request.resource.data);
        allow delete: if esDueno(uid);
      }

      match /comparablesHistoricas/{nameKey} {
        allow read: if esDueno(uid);
        allow create: if esDueno(uid)
          && comparableValida(request.resource.data)
          && request.resource.data.nameKey == nameKey
          && creacionCoherente(request.resource.data);
        allow update: if esDueno(uid)
          && comparableValida(request.resource.data)
          && request.resource.data.nameKey == nameKey
          && modificacionCoherente(request.resource.data);
        allow delete: if esDueno(uid);
      }

      match /eeffComparables/{registroId} {
        allow read: if esDueno(uid);
        allow create: if esDueno(uid)
          && eeffValido(request.resource.data)
          && creacionCoherente(request.resource.data);
        allow update: if esDueno(uid)
          && eeffValido(request.resource.data)
          && modificacionCoherente(request.resource.data);
        allow delete: if esDueno(uid);
      }
    }

    /* ── «Compartidos conmigo» ──
       La lista de estudios que otros me compartieron se consulta por grupo de
       colecciones: están dentro del espacio de cada dueño y quien pregunta no sabe de
       quién, así que la consulta recorre todas las subcolecciones `estudios` a la vez.

       Esta regla existe porque una consulta de grupo NO la autoriza la regla anclada a
       `usuarios/{uid}/estudios/{id}`: al no estar atada a un padre concreto, el motor
       necesita un patrón con comodín recursivo que coincida con ella. Sin esto la
       consulta se rechaza entera con «Missing or insufficient permissions», aunque cada
       documento por separado sí fuera legible.

       Solo concede lectura de los documentos que me nombran, y nada más: no permite
       enumerar los estudios de nadie. */
    match /{ruta=**}/estudios/{estudioId} {
      allow read: if estudioCompartidoConmigo();
    }

    // =============================================================
    // Colecciones del modelo compartido anterior
    // =============================================================
    //
    // Quedan solo para que cada consultor pueda recuperar y retirar lo que creó
    // cuando la base era común. Puede leer y borrar lo suyo —eso es lo que necesita
    // la migración— y nada más: no puede crear, no puede modificar, y no puede ver
    // los documentos de otro, que es justo el problema que este cambio viene a
    // cerrar. Una vez migrado todo, estas cuatro reglas pueden retirarse.

    function esMioEnLaRaiz() {
      return esMiembro()
        && resource.data.creadoPor is string
        && resource.data.creadoPor == request.auth.uid;
    }

    match /estudios/{estudioId} {
      allow read, delete: if esMioEnLaRaiz();
      allow create, update: if false;
    }

    match /clientes/{nit} {
      allow read, delete: if esMioEnLaRaiz();
      allow create, update: if false;
    }

    match /comparablesHistoricas/{nameKey} {
      allow read, delete: if esMioEnLaRaiz();
      allow create, update: if false;
    }

    match /eeffComparables/{registroId} {
      allow read, delete: if esMioEnLaRaiz();
      allow create, update: if false;
    }

    // Cualquier ruta no declarada arriba queda negada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
