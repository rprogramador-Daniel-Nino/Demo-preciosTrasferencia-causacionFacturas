{
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "predeploy": [
      "npm run build"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "//": "El HTML nunca se cachea: si el navegador reutiliza un index.html viejo, pide un bundle que el build siguiente ya borró y la aplicación ejecuta código anterior sin que se note.",
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "//": "Los assets llevan el hash del contenido en el nombre, así que si cambian cambia la URL y se pueden cachear indefinidamente.",
        "source": "/gestor-reportes/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/claude",
        "function": "claude"
      },
      {
        "source": "/api/extraer-rut",
        "function": "extraerRut"
      },
      {
        "source": "/api/extraer-camara",
        "function": "extraerCamara"
      },
      {
        "source": "/api/gemini",
        "function": "gemini"
      },
      {
        "source": "/api/generar-analisis-sector",
        "function": "generarAnalisisSector"
      },
      {
        "source": "/gestor-reportes-inicio",
        "destination": "/gestor-reportes/index.html"
      },
      {
        "source": "/gestor-reportes/**",
        "destination": "/gestor-reportes/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
